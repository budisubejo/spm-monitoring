[Unit]
Description=SPM Monitoring Laravel Server
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/spm-project/spm-monitoring
ExecStart=/usr/bin/php artisan serve --host=0.0.0.0 --port=8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
